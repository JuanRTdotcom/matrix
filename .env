# ─────────────────────────────────────────────────────────────
# Configuración única de todo el stack. Copia a .env:  cp .env.example .env
# docker-compose la lee automáticamente y la distribuye a cada servicio.
# ─────────────────────────────────────────────────────────────

# Seguridad (compartida por la API en Go y la API en Node)
JWT_SECRET=u29603blc323uk7u9nmirz0u475xhxf9j
TOKEN_EXPIRY_MINUTES=60

# Credenciales de demo (solo las usa la API en Go para /auth/login)
AUTH_USER=admin
AUTH_PASS=admin123

# Puertos (host = contenedor)
GATEWAY_PORT=3000
NODE_PORT=4000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=*

# URL de la API en Go que consume el navegador (corre en el host).
PUBLIC_GO_API_URL=http://localhost:3000
